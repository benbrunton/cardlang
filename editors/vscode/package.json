{
  "name": "cardlang",
  "displayName": "cardlang",
  "description": "Syntax highlighting for cardlang (.card) card game files",
  "version": "0.1.0",
  "publisher": "cardlang",
  "repository": {
    "type": "git",
    "url": "https://github.com/benbrunton/cardlang"
  },
  "private": true,
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "cardlang",
        "aliases": [
          "cardlang",
          "card"
        ],
        "extensions": [
          ".card"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "cardlang",
        "scopeName": "source.cardlang",
        "path": "./syntaxes/cardlang.tmLanguage.json"
      }
    ]
  },
  "scripts": {
    "test": "node --test"
  },
  "devDependencies": {
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.3.2"
  }
}
