.(Scopa - DRAFT. This file uses proposed syntax that doesn't exist yet,
  so it doesn't parse. Each new piece is marked DESIGN n; see the list in
  the PR / chat. Syntax that works today is unmarked.

  Rules (2 players):
  - 40 cards: a normal deck without the 8s, 9s and 10s.
    Jack = 8, Queen = 9, King = 10. Diamonds are the "coins" suit and the
    7 of diamonds is the settebello.
  - Each hand: 4 cards face up in the middle, 3 to each player. When both
    hands are empty, 3 more each (none to the middle) until the deck runs out.
  - On your turn, play one card:
      take - capture cards from the middle that add up to your card. If a
             single card has the same value as yours, you must take that one.
      drop - put the card in the middle. Only allowed if you can't capture.
  - Clearing the middle is a scopa: 1 point, except on the last play of a hand.
  - End of hand: whoever captured last takes the cards left in the middle.
    Then 1 point each for most cards, most diamonds, the settebello and
    most 7s (a tie scores nothing), plus 1 point per scopa.
  - First to 11 at the end of a hand wins; if tied, play another hand.
    The deal alternates, and the player after the dealer goes first.)

name scopa
players 2

.(DESIGN 1: a deck declaration that removes ranks)
deck standard without Eight Nine Ten

values { Jack 8, Queen 9, King 10 }

stack middle
stack collection per player

.(DESIGN 2: variables - for the whole game, or one per player.
  Numbers start at 0.)
var dealer
var last_capturer
var score per player
var scopas per player

def setup(){
    dealer = 2
    new_hand()
}

def new_hand(){
    .(DESIGN 3: gather() puts every card from every pile back in the deck)
    gather()
    shuffle(deck)
    every player p {
        p:scopas = 0
    }
    if(dealer is 1){
        dealer = 2
    } else {
        dealer = 1
    }
    .(DESIGN 2: assigning current_player, so the player after the dealer starts)
    if(dealer is 1){
        current_player = 2
    } else {
        current_player = 1
    }
    deck > middle 4
    deck > players 3
}

def player_move(player, move){
    check(player:id is current_player, it's not your turn)
    valid_moves(take, drop)
    after_move()
    next_player()
}

def take(player, move){
    check(count(move:cards) is 1, play one card from your hand, e.g. take 5d / 2c 3s)
    check(count(move:target) > 0, put a / before the cards you're capturing, e.g. take 5d / 2c 3s)
    check(cards_in_stack(move:cards, player:hand), you can only play a card from your hand)
    check(cards_in_stack(move:target, middle), you can only capture cards from the middle)
    check(sum(move:target) is sum(move:cards), the cards you capture must add up to the card you play)

    .(DESIGN 4: "any" - true if the condition holds for at least one)
    if(any card c in middle: c:value is sum(move:cards)){
        check(count(move:target) is 1, a card in the middle matches yours - you must take that card on its own)
    }

    middle > player:collection taking move:target
    player:hand > player:collection taking move:cards
    last_capturer = player:id

    .(a scopa, unless this was the last play of the hand)
    if(count(middle) is 0 & is_last_play() is false){
        player:scopas = player:scopas + 1
    }
}

def drop(player, move){
    check(count(move:cards) is 1, drop one card, e.g. drop 5d)
    check(count(move:target) is 0, to capture cards use take, e.g. take 5d / 2c 3s)
    check(can_capture(player) is false, you can capture, so you must - use take)
    player:hand > middle taking move:cards
}

.(DESIGN 5: "group" - every combination of cards from a pile, for
  "can any cards in the middle add up to this card?")
def can_capture(player){
    return(any card c in player:hand: any group g in middle: sum(g) is c:value)
}

.(true once the deck and every hand are empty)
def is_last_play(){
    return(count(deck) is 0 & every player p: count(p:hand) is 0)
}

def after_move(){
    if(every player p: count(p:hand) is 0){
        if(count(deck) > 0){
            deck > players 3
        } else {
            end_hand()
        }
    }
}

def end_hand(){
    .(the last player to capture takes what's left in the middle)
    every player p {
        if(p:id is last_capturer){
            middle > p:collection end
        }
    }

    score_most(is_any_card)
    score_most(is_diamond)
    score_most(is_seven)
    every player p {
        .(DESIGN 6: a card literal, [7d], for one specific card)
        if(cards_in_stack([7d], p:collection)){
            p:score = p:score + 1
        }
        p:score = p:score + p:scopas
    }

    if(any player p: p:score >= 11){
        end_game()
    } else {
        new_hand()
    }
}

.(1 point to the player with the most cards of a kind; a tie scores nothing.
  DESIGN 8: passing a function (is_diamond) as an argument, for filter)
def score_most(kind){
    every player p {
        if(every player q: q:id is p:id or count(filter(p:collection, kind)) > count(filter(q:collection, kind))){
            p:score = p:score + 1
        }
    }
}

def end_game(){
    every player p {
        if(every player q: q:id is p:id or p:score > q:score){
            winner(p:id)
            end()
            return(true)
        }
    }
    .(tied for the lead: play another hand)
    new_hand()
}

def is_any_card(card){
    return(true)
}

def is_diamond(card){
    return(card:suit is Diamonds)
}

def is_seven(card){
    return(card:rank is Seven)
}

.(DESIGN 7: the table shows per-player variables, e.g.
    score: player 1: 4, player 2: 6
    scopas: player 1: 1, player 2: 0)
