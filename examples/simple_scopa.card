.(Simple Scopa: Scopa with a normal 52-card deck and no end-of-round scoring.

  Four cards are dealt face up to the middle and three to each player.
  On your turn, play one card from your hand:
    take - capture cards from the middle whose values add up to your card,
           e.g. 'take 9d / 4c 5s' (aces are 1, jacks 11, queens 12, kings 13)
    drop - put the card in the middle, e.g. 'drop 9d'
  You can leave out the move name: '9d / 4c 5s' takes, '9d' drops.
  When all hands are empty, three more cards are dealt to each player.
  When the deck and hands are all empty, whoever captured most cards wins.
  Works for 2 to 4 players: change 'players 2' below.)

name simple_scopa
players 2
current_player 1
stack middle
player stack collection

def setup(){
    shuffle(deck)
    deck > middle 4
    deck > players 3
}

def player_move(player, move){
    check(player:id is current_player, it's not your turn)
    valid_moves(take, drop)
    after_move()
    next_player()
}

def take(player, move){
    check(count(move:cards) is 1, play one card from your hand, e.g. take 9d / 4c 5s)
    check(count(move:target) > 0, put a / before the cards you're capturing, e.g. take 9d / 4c 5s)
    check(cards_in_stack(move:cards, player:hand), you can only play a card from your hand)
    check(cards_in_stack(move:target, middle), you can only capture cards from the middle)
    check(sum(move:target) is sum(move:cards), the cards you capture must add up to the card you play)
    middle > player:collection taking move:target
    player:hand > player:collection taking move:cards
}

def drop(player, move){
    check(count(move:cards) is 1, drop one card, e.g. drop 9d)
    check(count(move:target) is 0, to capture cards use take, e.g. take 9d / 4c 5s)
    player:hand > middle taking move:cards
}

def hands_empty(){
    return(every player p: count(p:hand) is 0)
}

def after_move(){
    if(hands_empty() & count(deck) is 0){
        end_game()
    } else if(hands_empty()){
        deck > players 3
    }
}

.(everyone with the most cards wins, so a tie has several winners)
def end_game(){
    every player p {
        if(every player q: count(p:collection) >= count(q:collection)){
            winner(p:id)
        }
    }
    end()
}
