name turns
deck standard
players 2
current_player 1
stack middle

def setup(){
    shuffle(deck)
    deck > players end
}

def player_move(player){
    check(player:id is current_player)
    player:hand > middle

    if(count(player:hand) is 0){
        winner(player:id)
        end()
    }
    next_player()
}

.test(
    .(
    test game_can_start(game) {
        game:start()

        check(game:show("game") is "active")
    }
    )
)